# Build output (regenerated by tModLoader / dotnet)
bin/
obj/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Training output: checkpoints and TensorBoard logs. The shipped models (results/training/<run>/model.pt) are in
# Git LFS (.gitattributes); other checkpoints stay on the training PC.
Training/logs/
Training/models/
ppo_terraria_logs/
models/
*.zip

# Terraria MCP virtual environment (recreate: see tools/README.md)
tools/.venv/

# Profiler traces and physics trajectory dumps (large, regenerable); results/bench/bench.csv is kept
results/profiles/
results/bench/physics_*.json

# Training runs (configs, progress.csv and evaluations are small and kept; checkpoints are not, except the shipped
# model.pt files, added with git add -f)
results/training/**/*.pt
results/training/**/sb3_model*

# Physics movement graphs (1.2 GB; regenerated from the worlds with navigate.movegraph)
Training/movegraphs/
